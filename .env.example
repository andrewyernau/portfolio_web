# Local-only defaults. Copy this file to .env and replace every CHANGE_ME value
# before exposing the stack beyond localhost.
COMPOSE_PROJECT_NAME=portfolio
PUBLIC_HTTP_PORT=8080

POSTGRES_DB=portfolio
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=CHANGE_ME_local_database_password
DATABASE_URL=postgresql://portfolio:CHANGE_ME_local_database_password@postgres:5432/portfolio

APP_ENV=development
LOG_LEVEL=info
API_PORT=3000
TRUST_PROXY=true
TRUSTED_PROXY_HOPS=1
ANALYTICS_HMAC_SECRET=CHANGE_ME_at_least_32_random_characters
ANALYTICS_RETENTION_DAYS=90
CONTACT_RETENTION_DAYS=90
CONTACT_RATE_LIMIT_PER_HOUR=5
TRUSTED_PROXY_ADDRESSES=
COUNTRY_HEADER=x-country-code

SMTP_MODE=smtp
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=portfolio@example.test
SMTP_TO=owner@example.test
OUTBOX_POLL_MS=1000
OUTBOX_MAX_ATTEMPTS=10

GRAFANA_HTTP_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_local_grafana_password
PROMETHEUS_HTTP_PORT=9090
MAILPIT_HTTP_PORT=8025

ALERT_EMAIL_TO=owner@example.test
BACKUP_SCHEDULE=0 3 * * *
BACKUP_RETENTION_DAYS=14
